{
  "name": "opencode-council",
  "version": "0.1.0",
  "description": "Multi-model code workflow for opencode: role x model fan-out, deterministic aggregation, bounded convergence, and a closed fix loop.",
  "type": "module",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "opencode",
    "plugin",
    "multi-model",
    "code-review",
    "agents",
    "orchestration"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-azab/opencode-council.git"
  },
  "bugs": {
    "url": "https://github.com/a-azab/opencode-council/issues"
  },
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "test": "node --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "syntaxcheck": "tsc --noEmit --noCheck",
    "check": "npm run syntaxcheck && npm test"
  },
  "files": [
    "src",
    "!src/*.test.ts",
    "agent",
    "command",
    "skills",
    ".claude",
    "README.md",
    "PLAN.md"
  ],
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  }
}
